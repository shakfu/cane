(* Cane grammar, as implemented by include/cane/lex.hpp and parse.hpp.
   Precedence is not encoded here: see the operator table in README.md.
   Whitespace may appear between any two tokens. *)

(* Lexical *)
comment    = "#!" , { ? any character except newline ? } ;
number     = digit , { digit } | note ;
(* Scientific pitch, any case: `C4` is 60. Not followed by a letter,
   digit or "_", else it is an identifier. *)
note       = ? a-g or A-G ? , [ "#" | "b" ] , digit ;
string     = '"' , { ? any character except '"' ? } , '"' ;
identifier = ( letter | "_" ) , { letter | digit | "_" } ;  (* not a keyword or note *)

keyword = "lcm" | "gcd" | "or" | "xor" | "and" | "vel" | "gate" | "fit"
        | type ;

type = "num" | "number" | "str" | "string" | "rhy" | "rhythm"
     | "mel" | "melody" | "seq" | "sequence" | "pat" | "pattern" ;

(* A run of steps is one rhythm literal: `!.!.` and `! . ! .` are equal. *)
rhythm = step , { step } ;
step   = "!" | "." ;

(* Elements bind tighter than `,`. A trailing `,` is allowed. *)
melody = "[" , [ expression , { "," , expression } , [ "," ] ] , "]" ;

(* One element per cycle. Same element rules as a melody, but at least one.
   `>>` lexes as rotate, so a nested close needs a space: `<a, <b> >`. *)
alternation = "<" , expression , { "," , expression } , [ "," ] , ">" ;

(* Program *)
program = [ expression , [ ";" ] ] ;

expression = primary
           | prefix , expression
           | expression , postfix
           | expression , infix , expression
           | identifier , { identifier } , "=" , expression
                (* binding; with parameters, a function *)
           | expression , expression ;  (* call: `f a`, binds tightest *)

primary = number | string | identifier | rhythm | melody | alternation
        | "(" , expression , ")"
        | "(" , infix , [ expression ] , ")"  (* section; `(- a)` negates *)
        | "(" , expression , infix , ")"      (* section *)
        | "\" , identifier , "->" , type , expression ;  (* function *)

prefix  = "-" | "~" | "'" ;
postfix = "++" | "--" ;

infix = ";" | "~>" | "|" | "," | "@"
      | "or" | "xor" | "and"
      | "**" | "vel" | "gate" | "fit" | "<<" | ">>"
      | "+" | "-" | "*" | "/"
      | ":" | "lcm" | "gcd" | "?" ;  (* `;` and `=` group right to left *)
